# Bu dosyayı .env olarak kopyalayabilirsin. Anahtarları buraya yazmak zorunda değilsin.
# Herkes kendi anahtarını Lucy içinde Ayarlar ekranından girer. Anahtar yalnızca o bilgisayarda kalır.
# .env dosyasını repoya ekleme.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# İsteğe bağlı
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
